# Устройство фермы. Эти значения выдаёт админка при создании фермы.
# Ключа полного доступа (sb_secret_) здесь БЫТЬ НЕ ДОЛЖНО.
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_ANON_KEY=sb_publishable_...
DEVICE_LOGIN=device-xxxxxx@livestock.local
DEVICE_PASSWORD=выданный-админкой-пароль

# Необязательно: ручной режим отладки. Подменяет АДРЕС камеры, а карточку
# берёт с сервера — чтобы события ушли на существующую камеру.
#
# 0 — встроенная камера, 1 — обычно айфон по Continuity Camera. Список с
# именами: ./.venv/bin/python scripts/cameras.py
# VIDEO_SOURCE=0
#
# CAMERA_ID необязателен: без него берётся первая камера фермы.
# CAMERA_ID=uuid-камеры

# Какой скот считать. По умолчанию cow,sheep,horse — это крупный рогатый,
# овцы с козами (модель их не различает) и лошади.
#
# Птицу надо включать отдельно: вороны над загоном раздули бы поголовье.
# Верблюдов модель не знает вовсе.
#
# person — только для проверки на ноутбучной камере. Забытая на ферме,
# эта настройка означает, что скот не считается совсем; сервис
# предупредит об этом при запуске.
# TRACKED_CLASSES=cow,sheep,horse

# Окно предпросмотра: видео с рамками поверх найденных объектов.
# Пригодится при наведении камеры на ферме. Выход — клавиша q.
# SHOW_PREVIEW=1

# Как часто отправлять кадр для предпросмотра на сайте, секунды.
# 0 выключает отправку. По умолчанию 15.
# SNAPSHOT_INTERVAL_S=15

# Сводка по поголовью: как часто писать, секунды. По умолчанию 60.
# HEADCOUNT_INTERVAL_S=60

# --- Сбор кадров для дообучения ---------------------------------------
#
# Снимки предпросмотра выше для обучения НЕ ГОДЯТСЯ: на них нарисованы
# рамки, и путь у них постоянный — файл перезаписывается каждые 15 секунд.
# Поэтому отдельный сбор: чистые кадры, полного размера, с накоплением.
#
# Дата, до которой идёт сбор, включительно. Пусто — сбор выключен.
# Именно дата, а не «включено»: сбор нужен две недели, а забытым он
# остаётся месяцами. Непонятное значение тоже означает ВЫКЛЮЧЕНО —
# опечатка не должна включать сбор навсегда.
# TRAINING_COLLECT_UNTIL=2026-09-05

# Как часто брать кадр, секунды. По умолчанию 30. Чаще не надо: соседние
# кадры почти одинаковы, и модель много раз увидит одно и то же.
# TRAINING_INTERVAL_S=30

# Потолок кадров в сутки на камеру. По умолчанию 200. Второй рубеж после
# срока — на случай, если дату выставили на год по ошибке.
# TRAINING_DAILY_CAP=200

# Сбор вырезанных кадров животных для именования. По умолчанию включён.
# COLLECT_CROPS=1

# Распознавание особей. Модель тяжёлая (сотни МБ), поэтому по умолчанию выключено:
# кадры собираются и без неё, их можно называть вручную.
# REID_ENABLED=1
# REID_MODEL=hf-hub:BVRA/MegaDescriptor-L-384

# Сколько ядер отдать модели узнавания. По умолчанию половина.
#
# Это не тонкая настройка, а защита трекинга. Torch по умолчанию
# забирает ВСЕ ядра, а на мини-ПК их четыре и на каждую камеру уходит
# почти одно. Пока считается вектор — две-четыре секунды, — захват
# кадров остаётся без процессора, трекер теряет животное между кадрами
# и выдаёт ему новый номер. Со стороны это выглядит как завышенное
# поголовье, и связать одно с другим нечем.
#
# Поднимать имеет смысл только на машине, где камера одна.
# REID_THREADS=2

# Модель детекции. По умолчанию сегментационная: даёт контур животного,
# а не только рамку, и каждое животное красится своим цветом.
# Обычная (быстрее, без контуров): yolov8n.pt
# YOLO_MODEL=yolov8n-seg.pt

# Частота работы трекера, кадров в секунду. По умолчанию 8.
# Ниже 4 ставить нельзя: трекер перестаёт удерживать животное между кадрами
# и начинает выдавать одному и тому же новый номер — поголовье завышается.
# TRACK_FPS=8

# Буфер событий на время обрыва связи. По умолчанию spool.db рядом с сервисом.
# EVENT_SPOOL_PATH=/var/lib/livestock/spool.db

# Обмер силуэта для оценки веса. Работает только на камерах,
# отмеченных в админке как «вид сверху». По умолчанию включён.
# ESTIMATE_WEIGHT=1

# Живой просмотр камеры из дашборда: как часто отдавать кадр, пока
# открыто окно. По умолчанию 1 секунда. Настоящее видео через интернет
# не гоняем — один поток это около двух мегабит в секунду.
# LIVE_SNAPSHOT_INTERVAL_S=1

# Поток видео по локальной сети фермы. Когда хозяин ходит по ферме
# с телефоном в той же сети, трафик наружу не выходит и можно смотреть
# настоящее видео. Без STREAM_TOKEN поток не поднимется.
#
# Адрес потока устройство прописывает камерам само при запуске — вбивать
# его в админку руками больше не нужно.
# STREAM_ENABLED=1
# STREAM_TOKEN=придумайте-длинную-строку
# STREAM_PORT=8089
# STREAM_FPS=30
#
# Адрес, по которому до устройства достучится дашборд. Определяется сам;
# задавать вручную нужно, только если на машине несколько сетей и
# автоматика выбрала не ту.
# STREAM_HOST=192.168.1.50

# Сервер ретрансляции: живое видео, когда телефон НЕ в сети фермы.
#
# Ферма подключается к нему сама — белый адрес и проброс портов не нужны.
# Отдаётся готовый H.264 прямо с камеры, без перекодирования: около
# 400 кбит/с вместо восьми мегабит у потока картинками.
#
# Пусто — наружу не отдаём, всё работает как раньше по локальной сети.
# Нужен установленный ffmpeg: brew install ffmpeg / apt install ffmpeg
# RELAY_URL=https://video.вашдомен.kz

# Распознавание особей на слабой машине можно выключить: кадры продолжат
# собираться, назвать животных можно вручную. Сам расчёт вектора идёт
# в отдельном потоке и видео не останавливает, но на процессоре без
# ускорителя занимает секунду-две на кадр.
# REID_ENABLED=0

# Охрана: тревога, если ночью в кадре человек.
#
# Выключено по умолчанию не из осторожности к коду, а по закону: снимать
# людей нельзя, пока на ферме не оформлены приказ о видеонаблюдении,
# ознакомление под роспись и таблички на входах.
#
# Включается ещё и покамерно — в настройках камеры в админке.
# Охранное окно, выдержка и пауза настраиваются в дашборде.
# SECURITY_ENABLED=1

# Насколько уверенно должен опережать лучший кандидат, чтобы система
# назвала кличку. Если два животных похожи на кадр одинаково, ближайший
# из них — результат подбрасывания монеты, и неверная кличка на кадре
# разрушает доверие быстрее, чем её отсутствие.
# REID_MIN_MARGIN=0.05

# Система сама запоминает незнакомую особь и со следующего раза узнаёт
# её, показывая номер над животным. Человек потом переименовывает
# «№ 12» в «Зорьку»; до этого всё работает без него.
#
# Цена: автоматическое заведение неизбежно плодит двойников — животное,
# впервые снятое сзади в темноте, а второй раз сбоку днём, станет двумя
# записями. В разделе «Животные» есть слияние.
# AUTO_ENROLL=1
# AUTO_ENROLL_MIN_CONFIDENCE=0.75
# AUTO_ENROLL_MIN_AREA=40000
# AUTO_ENROLL_MIN_SIGHTINGS=2



# Считать людей наравне с животными.
#
# Нужно, пока фермы нет: проверить узнавание, вес и движение можно
# только на себе. Человек в этом режиме заводится, записывается и
# узнаётся так же, как корова.
#
# Что при этом ломается — намеренно и об этом сервис пишет при запуске:
#
#   - охрана не работает. Человек не может быть одновременно подопечным
#     и посторонним: тревога поднималась бы на каждого, кого система
#     считает;
#   - в поголовье попадают люди, и числа этого запуска к настоящей
#     ферме отношения не имеют.
#
# Человека не надо вписывать в TRACKED_CLASSES — эта строка добавляет
# его к списку сама, что бы там ни стояло.
#
# На ферме строки быть не должно.
# COUNT_PEOPLE=1

# Насколько далёким может быть эталон, чтобы животное считалось узнанным.
#
# Косинусное расстояние: ноль — тот же самый кадр, единица — ничего
# общего. Порог зависит и от модели, и от того, кого снимают: на людях
# у MegaDescriptor расстояния другие, чем на скоте.
#
# Подбирать вслепую нельзя — сначала посмотрите в журнал. Там на каждую
# неудачу печатается «не узнано: ближайший на 0.42 при пороге 0.35».
# Если ближайший стабильно чуть выше порога, порог можно поднять; если
# он около 0.8 — дело не в пороге, а в модели.
# REID_THRESHOLD=0.35
