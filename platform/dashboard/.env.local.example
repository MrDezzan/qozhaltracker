# Публичные — попадают в браузер, это нормально
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...
NEXT_PUBLIC_APP_URL=http://localhost:3000

# СЕКРЕТНЫЙ — только на сервере, никогда не коммитить.
# Нужен для создания учётных записей ферм в админке.
SUPABASE_SECRET_KEY=sb_secret_...

# Домен для синтетических логинов (клиенту не показывается)
LOGIN_EMAIL_DOMAIN=livestock.local

# Сервер ретрансляции видео: живое видео, когда телефон НЕ в сети фермы.
# Пусто — режим выключен, остаётся только просмотр внутри сети фермы.
# NEXT_PUBLIC_RELAY_URL=https://video.вашдомен.kz

# Общий пароль между дашбордом и сервером ретрансляции. Сервер шлёт его
# заголовком x-relay-secret, когда спрашивает разрешение на подключение.
# СЕКРЕТНЫЙ, только на сервере.
# RELAY_AUTH_SECRET=длинная-случайная-строка
