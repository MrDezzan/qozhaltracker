# ── Секреты ───────────────────────────────────────────────────────────
# Правило шире, чем кажется нужным, и это намеренно: одна забытая копия
# .env под другим именем стоит дороже, чем лишняя строка здесь.
.env
.env.*
!.env.example
!.env.local.example
*.pem
*.key
*.p12
*.pfx
id_rsa*
secrets.*
credentials.*

# ── Зависимости и сборка ──────────────────────────────────────────────
node_modules/
.next/
out/
dist/
build/
.venv/
venv/
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
tsconfig.tsbuildinfo

# ── Веса моделей ──────────────────────────────────────────────────────
# Скачиваются при первом запуске, в репозитории им делать нечего:
# тринадцать мегабайт на каждый коммит истории ни за что.
*.pt
*.onnx
*.engine
*.weights

# ── Данные во время работы ────────────────────────────────────────────
# spool.db — буфер событий фермы. В нём настоящие наблюдения, публиковать
# его нельзя ни при каких обстоятельствах.
spool.db
spool.db-wal
spool.db-shm
*.sqlite
*.sqlite3
logs/
*.log

# ── Система ───────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
